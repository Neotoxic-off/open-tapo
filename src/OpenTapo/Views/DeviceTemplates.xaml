<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:OpenTapo.ViewModels">

    <!-- One labelled switch row; collapses when the device doesn't report the setting. -->
    <DataTemplate DataType="{x:Type vm:SettingToggle}">
        <Grid Margin="0,2" Visibility="{Binding IsSupported, Converter={StaticResource Visible}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="22" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Glyph}" FontSize="12" HorizontalAlignment="Left" Text="{Binding Glyph}" />
            <TextBlock Grid.Column="1" FontSize="12" VerticalAlignment="Center" Text="{Binding Label}" />
            <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsOn}" />
        </Grid>
    </DataTemplate>

    <ItemsPanelTemplate x:Key="HorizontalPanel">
        <StackPanel Orientation="Horizontal" />
    </ItemsPanelTemplate>

    <DataTemplate x:Key="PresetSwatch" DataType="{x:Type vm:LightPreset}">
        <Button Style="{StaticResource Swatch}" Background="{Binding Swatch}" ToolTip="{Binding Name}"
                Command="{Binding DataContext.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                CommandParameter="{Binding}" />
    </DataTemplate>

    <LinearGradientBrush x:Key="HueSpectrum" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#FF0000" />
        <GradientStop Offset="0.17" Color="#FFFF00" />
        <GradientStop Offset="0.33" Color="#00FF00" />
        <GradientStop Offset="0.5" Color="#00FFFF" />
        <GradientStop Offset="0.67" Color="#0000FF" />
        <GradientStop Offset="0.83" Color="#FF00FF" />
        <GradientStop Offset="1" Color="#FF0000" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="WhiteSpectrum" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#FFB46B" />
        <GradientStop Offset="0.5" Color="#FFF1E0" />
        <GradientStop Offset="1" Color="#D6E6FF" />
    </LinearGradientBrush>

    <!-- Second line of a row: the device state, replaced by the error when there is one. -->
    <Style x:Key="RowState" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasError}" Value="True">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="RowError" TargetType="TextBlock" BasedOn="{StaticResource ErrorText}">
        <Setter Property="FontSize" Value="12" />
        <!-- Errors are the one thing the user must read: wrap instead of truncating. -->
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- A hub's sensor line: name on the left, reading on the right, highlighted when it needs attention. -->
    <DataTemplate DataType="{x:Type vm:ChildReading}">
        <Grid Margin="26,2,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Caption}" Text="{Binding Name}" />
            <TextBlock x:Name="Reading" Grid.Column="1" Margin="8,0,0,0" FontSize="12" Text="{Binding Reading}" />
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsAlert}" Value="True">
                <Setter TargetName="Reading" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:SmartDeviceViewModel}">
        <Border Style="{StaticResource Row}">
            <StackPanel>
                <Grid Background="Transparent" Cursor="Hand" ToolTip="Show settings">
                    <Grid.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding ToggleExpandedCommand}" />
                    </Grid.InputBindings>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" FontSize="16" Margin="2,0,10,0">
                        <TextBlock.Foreground>
                            <SolidColorBrush Color="{Binding Glow}" />
                        </TextBlock.Foreground>
                    </TextBlock>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Title}" FontSize="13" Text="{Binding Name}" />
                        <TextBlock Style="{StaticResource RowState}" Text="{Binding State}" />
                        <TextBlock Style="{StaticResource RowError}" Text="{Binding Error}" />
                    </StackPanel>
                    <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" ToolTip="Turn on / off"
                              IsChecked="{Binding IsOn}" IsEnabled="{Binding IsReady}"
                              Visibility="{Binding SupportsPower, Converter={StaticResource Visible}}" />
                </Grid>

                <ItemsControl ItemsSource="{Binding Children}" />
                <ItemsControl Margin="26,2,0,0" ItemsSource="{Binding Outlets}" IsEnabled="{Binding IsReady}" />

                <StackPanel Margin="0,8,0,0" IsEnabled="{Binding IsReady}" Visibility="{Binding IsExpanded, Converter={StaticResource Visible}}">
                    <TextBlock Style="{StaticResource Footnote}" FontSize="12" Margin="0,0,0,4" Text="{Binding Energy}" />
                    <Slider Minimum="1" Maximum="4" TickFrequency="1" IsSnapToTickEnabled="True" TickPlacement="BottomRight" ToolTip="Fan speed"
                            Value="{Binding FanSpeed, Delay=250}" Visibility="{Binding SupportsFanSpeed, Converter={StaticResource Visible}}" />
                    <Slider Minimum="1" Maximum="100" IsMoveToPointEnabled="True" ToolTip="Brightness"
                            Value="{Binding Brightness, Delay=250}" Visibility="{Binding SupportsBrightness, Converter={StaticResource Visible}}" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <ItemsControl ItemsSource="{Binding Whites}" ItemsPanel="{StaticResource HorizontalPanel}" ItemTemplate="{StaticResource PresetSwatch}"
                                      Visibility="{Binding SupportsWhites, Converter={StaticResource Visible}}" />
                        <ItemsControl ItemsSource="{Binding Colors}" ItemsPanel="{StaticResource HorizontalPanel}" ItemTemplate="{StaticResource PresetSwatch}"
                                      Visibility="{Binding SupportsColors, Converter={StaticResource Visible}}" />
                    </StackPanel>
                    <StackPanel Margin="0,4,0,0" Visibility="{Binding SupportsWhites, Converter={StaticResource Visible}}">
                        <Border Height="3" Margin="6,4,6,0" CornerRadius="2" Background="{StaticResource WhiteSpectrum}" />
                        <Slider Minimum="{Binding MinColorTemperature}" Maximum="{Binding MaxColorTemperature}" IsMoveToPointEnabled="True"
                                Value="{Binding ColorTemperature, Delay=250}" ToolTip="White temperature" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding SupportsColors, Converter={StaticResource Visible}}">
                        <Border Height="3" Margin="6,4,6,0" CornerRadius="2" Background="{StaticResource HueSpectrum}" />
                        <Slider Minimum="0" Maximum="360" IsMoveToPointEnabled="True" Value="{Binding Hue, Delay=250}" ToolTip="Hue" />
                        <Slider Minimum="0" Maximum="100" IsMoveToPointEnabled="True" Value="{Binding Saturation, Delay=250}" ToolTip="Saturation" />
                    </StackPanel>
                    <ContentControl Content="{Binding Fade}" />
                    <TextBlock Style="{StaticResource Footnote}" FontSize="12" Margin="0,4,0,0" Visibility="{Binding HasUsage, Converter={StaticResource Visible}}">
                        <Run Text="On today" /> <Run Text="{Binding UsageToday, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text=" · 7 d" /> <Run Text="{Binding UsageWeek, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text=" · 30 d" /> <Run Text="{Binding UsageMonth, Mode=OneWay}" FontWeight="SemiBold" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource Footnote}" FontSize="12" Text="{Binding Signal}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:CameraViewModel}">
        <Border Style="{StaticResource Row}">
            <StackPanel>
                <Grid Background="Transparent" Cursor="Hand" ToolTip="Show settings">
                    <Grid.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding ToggleExpandedCommand}" />
                    </Grid.InputBindings>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE722;" FontSize="16" Margin="2,0,10,0"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Title}" FontSize="13" Text="{Binding Name}" />
                        <TextBlock Style="{StaticResource RowState}" Text="{Binding LastAlarm}" />
                        <TextBlock Style="{StaticResource RowError}" Text="{Binding Error}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Margin="8,0" VerticalAlignment="Center" FontSize="12" ToolTip="Battery">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Battery}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsBatteryLow}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        <Run FontFamily="Segoe UI Emoji" Text="🔋" /> <Run Text="{Binding Battery, Mode=OneWay}" />
                    </TextBlock>
                    <CheckBox Grid.Column="3" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                              IsChecked="{Binding IsActive}" IsEnabled="{Binding IsReady}" ToolTip="Camera on / privacy mode"
                              Visibility="{Binding SupportsPrivacy, Converter={StaticResource Visible}}" />
                </Grid>

                <ItemsControl ItemsSource="{Binding Children}" />

                <StackPanel Margin="0,8,0,0" IsEnabled="{Binding IsReady}" Visibility="{Binding IsExpanded, Converter={StaticResource Visible}}">
                    <ContentControl Content="{Binding MotionDetection}" />
                    <ItemsControl ItemsSource="{Binding Settings}" />
                    <ContentControl Content="{Binding Flip}" />

                    <Grid Margin="0,2" Visibility="{Binding HasNightVision, Converter={StaticResource Visible}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="22" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Glyph}" FontSize="12" HorizontalAlignment="Left" Text="&#xE708;" />
                        <TextBlock Grid.Column="1" FontSize="12" VerticalAlignment="Center" Text="Night vision" />
                        <ComboBox Grid.Column="2" MinWidth="96" FontSize="12" ItemsSource="{Binding NightVisionModes}" DisplayMemberPath="Label"
                                  SelectedItem="{Binding NightVision}" />
                    </Grid>

                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button HorizontalAlignment="Stretch" Padding="0,3" FontSize="12" Content="Sound siren" Command="{Binding StartSirenCommand}" />
                        <Button Grid.Column="2" HorizontalAlignment="Stretch" Padding="0,3" FontSize="12" Content="Stop siren" Command="{Binding StopSirenCommand}" />
                    </Grid>

                    <ProgressBar Height="3" Margin="0,8,0,0" Maximum="100" Value="{Binding StorageUsedPercent, Mode=OneWay}"
                                 Visibility="{Binding HasStorage, Converter={StaticResource Visible}}" />
                    <TextBlock Style="{StaticResource Footnote}" FontSize="12" Margin="0,4,0,0" Text="{Binding Storage}" />
                    <TextBlock Style="{StaticResource Footnote}" FontSize="12" Text="{Binding Signal}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:VacuumViewModel}">
        <Border Style="{StaticResource Row}">
            <StackPanel>
                <Grid Background="Transparent" Cursor="Hand" ToolTip="Show controls">
                    <Grid.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding ToggleExpandedCommand}" />
                    </Grid.InputBindings>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE99A;" FontSize="16" Margin="2,0,10,0"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Title}" FontSize="13" Text="{Binding Name}" />
                        <TextBlock Style="{StaticResource RowState}" Text="{Binding State}" />
                        <TextBlock Style="{StaticResource RowError}" Text="{Binding Error}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Margin="8,0" VerticalAlignment="Center" FontSize="12" ToolTip="Battery" Style="{StaticResource Caption}">
                        <Run FontFamily="Segoe UI Emoji" Text="🔋" /> <Run Text="{Binding Battery, Mode=OneWay}" />
                    </TextBlock>
                </Grid>

                <StackPanel Margin="0,8,0,0" IsEnabled="{Binding IsReady}" Visibility="{Binding IsExpanded, Converter={StaticResource Visible}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button HorizontalAlignment="Stretch" Padding="0,3" FontSize="12" Content="Clean" Command="{Binding StartCommand}" />
                        <Button Grid.Column="2" HorizontalAlignment="Stretch" Padding="0,3" FontSize="12" Content="Pause" Command="{Binding PauseCommand}" />
                        <Button Grid.Column="4" HorizontalAlignment="Stretch" Padding="0,3" FontSize="12" Content="Dock" Command="{Binding DockCommand}" />
                    </Grid>
                    <TextBlock Style="{StaticResource Footnote}" FontSize="12" Margin="0,4,0,0" Text="{Binding Signal}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </DataTemplate>

</ResourceDictionary>
