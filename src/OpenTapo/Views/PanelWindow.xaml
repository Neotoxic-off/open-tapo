<Window x:Class="OpenTapo.Views.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:OpenTapo.ViewModels"
        xmlns:views="clr-namespace:OpenTapo.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Tapo"
        Width="300"
        MaxHeight="560"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStyle="None"
        ShowInTaskbar="False"
        Topmost="True"
        Background="#E01C1C1C">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="-1" ResizeBorderThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <views:PlaceholderVisibilityConverter x:Key="PlaceholderVisibility" />
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="2,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" Text="{Binding Status}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Visibility="{Binding IsSignedIn, Converter={StaticResource Visible}}">
                <Button Style="{StaticResource IconButton}" Width="26" Height="26" FontSize="12" Content="&#xE72C;" ToolTip="Refresh" Command="{Binding RefreshCommand}" />
                <Button Style="{StaticResource IconButton}" Width="26" Height="26" FontSize="12" Content="&#xE721;" ToolTip="Scan for devices" Command="{Binding ScanCommand}" />
                <ToggleButton Style="{StaticResource IconToggle}" Content="&#xE710;" ToolTip="Add a device by IP" IsChecked="{Binding IsAddOpen}" />
                <ToggleButton Style="{StaticResource IconToggle}" Content="&#xE77B;" ToolTip="Account" IsChecked="{Binding IsAccountOpen}" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1">
            <Border Style="{StaticResource Row}" Padding="14,12" Visibility="{Binding IsSignedOut, Converter={StaticResource Visible}}">
                <StackPanel>
                    <Border Width="52" Height="52" CornerRadius="14" HorizontalAlignment="Center" Background="{StaticResource LogoBrush}">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xEA80;" FontSize="26" Foreground="White" />
                    </Border>
                    <TextBlock Style="{StaticResource Title}" FontSize="16" Margin="0,10,0,0" HorizontalAlignment="Center" Text="Welcome to open-tapo" />
                    <TextBlock Style="{StaticResource Caption}" FontSize="12" Margin="0,2,0,0" HorizontalAlignment="Center"
                               Text="Your Tapo home, right from the taskbar" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,12">
                        <Border Style="{StaticResource DeviceBadge}" ToolTip="Lights">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xEA80;" />
                        </Border>
                        <Border Style="{StaticResource DeviceBadge}" ToolTip="Plugs and switches">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE7E8;" />
                        </Border>
                        <Border Style="{StaticResource DeviceBadge}" ToolTip="Cameras">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE722;" />
                        </Border>
                        <Border Style="{StaticResource DeviceBadge}" ToolTip="Hubs and sensors">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE701;" />
                        </Border>
                    </StackPanel>

                    <Grid>
                        <TextBox x:Name="EmailBox" Padding="30,6,8,6" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" ToolTip="Tapo account email" />
                        <TextBlock Style="{StaticResource FieldGlyph}" Text="&#xE715;" />
                        <TextBlock Style="{StaticResource Caption}" Margin="31,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Text="Email">
                            <TextBlock.Visibility>
                                <MultiBinding Converter="{StaticResource PlaceholderVisibility}">
                                    <Binding Path="Text" ElementName="EmailBox" />
                                    <Binding Path="IsKeyboardFocused" ElementName="EmailBox" />
                                </MultiBinding>
                            </TextBlock.Visibility>
                        </TextBlock>
                    </Grid>
                    <Grid Margin="0,6,0,0">
                        <PasswordBox x:Name="PasswordInput" Padding="30,6,8,6" PasswordChanged="OnPasswordChanged" ToolTip="Tapo account password" />
                        <TextBlock Style="{StaticResource FieldGlyph}" Text="&#xE72E;" />
                        <TextBlock x:Name="PasswordPlaceholder" Style="{StaticResource Caption}" Margin="31,0,0,0" VerticalAlignment="Center"
                                   IsHitTestVisible="False" Text="Password" />
                    </Grid>

                    <Button Margin="0,12,0,0" HorizontalAlignment="Stretch" IsDefault="True"
                            Style="{DynamicResource AccentButtonStyle}" Command="{Binding SignInCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE721;" Margin="0,0,8,0" />
                            <TextBlock Text="Sign in and find my devices" />
                        </StackPanel>
                    </Button>
                    <TextBlock Style="{StaticResource ErrorText}" FontSize="12" Margin="0,6,0,0" HorizontalAlignment="Center" Text="{Binding SignInError}" />

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xEA18;" FontSize="14" VerticalAlignment="Top" Margin="0,1,8,0"
                                   Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource Caption}" FontSize="12" TextWrapping="Wrap"
                                   Text="Checked locally by your devices. Stored in the Windows Credential Locker, never sent to the cloud." />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Row}" Visibility="{Binding IsAccountOpen, Converter={StaticResource Visible}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" Text="{Binding Email}" ToolTip="Signed in" />
                    <Button Grid.Column="1" Margin="6,0,0,0" Padding="8,2" FontSize="12" Content="Sign out" Command="{Binding SignOutCommand}" />
                </Grid>
            </Border>

            <Grid Margin="0,0,0,4" Visibility="{Binding IsAddOpen, Converter={StaticResource Visible}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ManualIpBox" Text="{Binding ManualIp, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" />
                <TextBlock Style="{StaticResource Caption}" Margin="11,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Text="IP, e.g. 192.168.1.42">
                    <TextBlock.Visibility>
                        <MultiBinding Converter="{StaticResource PlaceholderVisibility}">
                            <Binding Path="Text" ElementName="ManualIpBox" />
                            <Binding Path="IsKeyboardFocused" ElementName="ManualIpBox" />
                        </MultiBinding>
                    </TextBlock.Visibility>
                </TextBlock>
                <Button Grid.Column="1" Margin="4,0,0,0" Content="Add" Command="{Binding AddDeviceCommand}" />
            </Grid>
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsSignedIn, Converter={StaticResource Visible}}">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Devices}" />
                <TextBlock Style="{StaticResource Caption}" Margin="0,6" HorizontalAlignment="Center"
                           Text="No devices found." Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
